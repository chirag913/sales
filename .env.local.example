# Copy this file to .env.local and fill in real values. .env.local is gitignored.

OPENAI_API_KEY=sk-...

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key for the sign-up CAPTCHA (AuthScreen.tsx).
# Public/safe to expose — the matching secret key lives only in the
# Supabase Dashboard (Authentication -> Attack Protection), never in this
# repo. Below is Cloudflare's published "always passes" test key, safe for
# local dev; swap in your real site key for a production build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Needed for addCredits() (src/lib/credits/addCredits.ts), called by the
# Razorpay verify/webhook routes. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (test mode keys while developing — never live keys locally).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Filled in after the webhook route is deployed and registered in the
# Razorpay dashboard (Settings -> Webhooks) — needs a real HTTPS URL.
RAZORPAY_WEBHOOK_SECRET=
