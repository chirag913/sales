# Copy this file to .env.local and fill in real values. .env.local is gitignored.

OPENAI_API_KEY=sk-...

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile site key for the sign-up CAPTCHA (AuthScreen.tsx).
# Public/safe to expose — the matching secret key lives only in the
# Supabase Dashboard (Authentication -> Attack Protection), never in this
# repo. Below is Cloudflare's published "always passes" test key, safe for
# local dev; swap in your real site key for a production build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Needed for addCredits() (src/lib/credits/addCredits.ts), called by the
# Razorpay verify/webhook routes. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (test mode keys while developing — never live keys locally).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Filled in after the webhook route is deployed and registered in the
# Razorpay dashboard (Settings -> Webhooks) — needs a real HTTPS URL.
RAZORPAY_WEBHOOK_SECRET=

# Public site URL, used for canonical / Open Graph / sitemap URLs. Defaults to
# https://bettercallz.com when unset.
NEXT_PUBLIC_SITE_URL=

# Official BetterCallz WhatsApp number for the floating chat button, digits
# only with country code. Defaults to 918447355977 when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Landing-page lead capture (POST /api/leads). The lead is always stored in the
# landing_leads table first (needs SUPABASE_SERVICE_ROLE_KEY above and migration
# 0019). Everything below is optional and server-only.
#
# Where to send each stored lead as JSON, e.g. a Google Apps Script web app that
# appends a Sheets row, or a Zapier / Make / n8n webhook. Unset = store only.
LEAD_WEBHOOK_URL=
# Sent as "Authorization: Bearer <secret>" so the receiver can reject others.
LEAD_WEBHOOK_SECRET=
# Random string mixed into the hashed client IP used for the form's rate limit.
LEAD_RATE_LIMIT_SALT=

# Email notification for each new landing-page lead (sent after the row is
# saved; a failure is logged and never affects the submission). Server-only.
# Both RESEND_API_KEY and LEAD_NOTIFY_EMAIL are required for it to send.
RESEND_API_KEY=
# Who to notify (comma-separated for several).
LEAD_NOTIFY_EMAIL=
# Sender. Defaults to "BetterCallz Leads <onboarding@resend.dev>", which Resend
# only delivers to the Resend account owner's own address. To notify anyone
# else, use an address on a domain verified in Resend.
LEAD_NOTIFY_FROM=
# Test hook only: send the request here instead of api.resend.com.
RESEND_API_URL=
